@startuml





/' Objects '/

class Color_rgb {
	+a : unsigned char
	+b : unsigned char
	+g : unsigned char
	+r : unsigned char
}


abstract class Renderer {
	+~Renderer()
	+{abstract} measureText(const char* text, int fontSize) : int
	+{abstract} beginCamera(const CameraData& camera) : void
	+{abstract} beginFrame() : void
	+{abstract} clear(Color_rgb color) : void
	+{abstract} drawCircle(int centerX, int centerY, float radius, Color_rgb color) : void
	+{abstract} drawRectangle(int x, int y, int width, int height, Color_rgb color) : void
	+{abstract} drawText(const std::string& text, int x, int y, int fontSize, Color_rgb color) : void
	+{abstract} endCamera() : void
	+{abstract} endFrame() : void
}





